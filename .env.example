# Copie para .env (gitignorado) e ajuste. Em produção nada disto vem de arquivo:
# DATABASE_URL vem do Secret Manager (secret database-url) via Cloud Run.

# Postgres local do docker-compose. Aponta para localhost, e não para o nome do serviço
# "postgres", porque esse nome só resolve dentro da rede do Docker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_researcher

# Vertex AI. Autenticação local por `gcloud auth application-default login` — nenhuma
# chave em arquivo. Os modelos só respondem na localização global.
GOOGLE_CLOUD_PROJECT=seu-project-id
GOOGLE_CLOUD_LOCATION=global

# Modelo por papel, nunca hardcoded no código. Trocar o de embedding invalida o índice:
# rode `pnpm seed` de novo.
MODEL_GRADE=gemini-3.5-flash-lite
MODEL_ANSWER=gemini-3.6-flash
MODEL_EMBEDDING=gemini-embedding-001

# Busca web, atrás da interface SearchProvider. "serper" (padrão) ou "google".
# A chave é segredo: local só no .env (gitignorado), em produção no Secret Manager.
SEARCH_PROVIDER=serper
SERPER_API_KEY=
# Só para SEARCH_PROVIDER=google (o Custom Search não aceita chaves novas):
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_CX=

# Limites da API pública (padrões conservadores; ver plan.md §9). O rate limit é global, um
# balde para todos os clientes; o orçamento conta tokens de LLM por dia (UTC), em memória.
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW=1 minute
# DAILY_TOKEN_BUDGET=300000

# Gateway MCP em /api/mcp. Desligado por padrão: em produção o MCP fica só no stdio e no
# servidor standalone local (packages/mcp-server, porta MCP_HTTP_PORT).
# MCP_GATEWAY=true

# Modo demo: "true" troca o grafo inteiro por peças sem rede — embeddings de zeros, busca que
# devolve o documento real da Vale 3T25 congelado, grade sempre suficiente, resposta fixa e
# busca web por fixtures fictícias. Não precisa de banco, Vertex AI nem SERPER_API_KEY, e não
# grava nada. Serve para o E2E e para gravar aula. Nunca em produção; o seed se recusa a rodar.
DEMO=false
